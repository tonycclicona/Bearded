<%- include('../partials/header') %>

<div class="max-w-3xl mx-auto">
  <h1 class="text-3xl font-bold mb-8">Crear Habitación de Lodge</h1>

  <form action="<%= listPath %>/create" method="POST" enctype="multipart/form-data" class="bg-white rounded-lg shadow p-6 space-y-5">
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Nombre de la Habitación / Cabaña</label>
      <input type="text" name="name" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none" placeholder="ej: Suite Panorámica Colibrí">
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 bg-gray-50 p-4 rounded-xl border border-gray-200">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Precio por Noche en Soles (PEN S/.)</label>
        <input type="number" name="pricePerNight" step="0.01" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none" placeholder="350.00">
        <label class="flex items-center gap-2 mt-2 text-xs font-semibold text-gray-700">
          <input type="checkbox" name="showPEN" checked class="w-4 h-4 text-blue-600 rounded">
          <span>Habilitar / Mostrar monto en Soles (PEN)</span>
        </label>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Precio por Noche en Dólares (USD $)</label>
        <input type="number" name="pricePerNightUSD" step="0.01" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none" placeholder="95.00">
        <label class="flex items-center gap-2 mt-2 text-xs font-semibold text-gray-700">
          <input type="checkbox" name="showUSD" class="w-4 h-4 text-blue-600 rounded">
          <span>Habilitar / Mostrar monto en Dólares (USD)</span>
        </label>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Capacidad (personas)</label>
        <input type="number" name="capacity" min="1" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none" value="2">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Orden</label>
        <input type="number" name="sortOrder" value="0" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
      </div>
    </div>

    {/* Imagen Principal */}
    <div class="border-t border-gray-100 pt-4">
      <label class="block text-sm font-semibold text-gray-700 mb-1">Foto Principal (Portada)</label>
      <div class="flex items-center gap-4">
        <img id="imagePreview" class="hidden w-32 h-24 object-cover rounded-lg border border-gray-200" alt="Preview">
        <div class="flex-1 space-y-2">
          <input type="file" name="image" accept="image/*" onchange="previewRoomImage(this)" class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100">
          <p class="text-xs text-gray-500">O ingresa una URL directa externa:</p>
          <input type="url" name="imageUrl" placeholder="https://..." class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
        </div>
      </div>
      <p class="text-xs text-gray-400 mt-1">Se optimizará automáticamente a formato WebP.</p>
    </div>

    {/* Galería de Múltiples Fotos del Lodge */}
    <div class="border-t border-gray-100 pt-4">
      <label class="block text-sm font-semibold text-gray-700 mb-1">Galería de Fotos Adicionales (Vistas, balcón, interiores)</label>
      <div class="space-y-3">
        <input type="file" name="galleryImages" accept="image/*" multiple onchange="previewGalleryImages(this)" class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100">
        <div id="galleryPreviews" class="flex flex-wrap gap-2 pt-1"></div>
        <div>
          <label class="block text-xs text-gray-500 mb-1">URLs adicionales para la galería (una por línea):</label>
          <textarea name="gallery" rows="3" placeholder="https://ejemplo.com/foto1.jpg&#10;https://ejemplo.com/foto2.jpg" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none text-xs font-mono"></textarea>
        </div>
      </div>
    </div>

    <div class="border-t border-gray-100 pt-4">
      <label class="block text-sm font-medium text-gray-700 mb-1">Amenities y Servicios (uno por línea)</label>
      <textarea name="amenities" rows="4" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none" placeholder="Cama King Size con plumón térmico&#10;Balcón privado con vista a los bebederos&#10;Agua caliente y calefacción ecológica&#10;Desayuno orgánico incluido"></textarea>
    </div>

    <div class="flex items-center gap-2 text-sm font-medium text-gray-700">
      <input type="checkbox" name="featured" class="w-4 h-4 text-blue-600 rounded">
      <span>Destacar en página principal</span>
    </div>

    <div class="flex gap-3 pt-3">
      <button type="submit" class="bg-blue-600 text-white px-6 py-2.5 rounded-lg hover:bg-blue-700 font-semibold text-sm">Crear Habitación</button>
      <a href="<%= listPath %>" class="bg-gray-200 text-gray-700 px-6 py-2.5 rounded-lg hover:bg-gray-300 font-semibold text-sm">Cancelar</a>
    </div>
  </form>
</div>

<script>
  function previewRoomImage(input) {
    var preview = document.getElementById('imagePreview');
    if (input.files && input.files[0]) {
      preview.src = URL.createObjectURL(input.files[0]);
      preview.classList.remove('hidden');
    }
  }

  function previewGalleryImages(input) {
    var container = document.getElementById('galleryPreviews');
    container.innerHTML = '';
    if (input.files && input.files.length > 0) {
      for (var i = 0; i < input.files.length; i++) {
        var img = document.createElement('img');
        img.src = URL.createObjectURL(input.files[i]);
        img.className = 'w-20 h-16 object-cover rounded-lg border border-gray-200 shadow-sm';
        container.appendChild(img);
      }
    }
  }
</script>

<%- include('../partials/footer') %>