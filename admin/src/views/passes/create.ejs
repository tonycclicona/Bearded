<%- include('../partials/header') %>

<div class="max-w-3xl mx-auto">
  <h1 class="text-3xl font-bold mb-8">Crear Pase</h1>

  <form action="<%= listPath %>/create" method="POST" class="bg-white rounded-lg shadow p-6 space-y-4">
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Título</label>
      <input type="text" name="title" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 bg-gray-50 p-4 rounded-xl border border-gray-200">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Precio en Soles (PEN S/.)</label>
        <input type="number" name="price" step="0.01" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none" placeholder="120.00">
        <label class="flex items-center gap-2 mt-2 text-xs font-semibold text-gray-700">
          <input type="checkbox" name="showPEN" checked class="w-4 h-4 text-blue-600 rounded">
          <span>Habilitar / Mostrar monto en Soles (PEN)</span>
        </label>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Precio en Dólares (USD $)</label>
        <input type="number" name="priceUSD" step="0.01" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none" placeholder="35.00">
        <label class="flex items-center gap-2 mt-2 text-xs font-semibold text-gray-700">
          <input type="checkbox" name="showUSD" class="w-4 h-4 text-blue-600 rounded">
          <span>Habilitar / Mostrar monto en Dólares (USD)</span>
        </label>
      </div>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Descripción</label>
      <textarea name="description" rows="3" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none"></textarea>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Beneficios (uno por línea)</label>
      <textarea name="features" rows="5" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none"></textarea>
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Orden</label>
        <input type="number" name="sortOrder" value="0" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
      </div>
      <div>
        <label class="flex items-center gap-2 mt-6 text-sm font-medium text-gray-700">
          <input type="checkbox" name="featured" class="w-4 h-4">
          Destacado (recomendado)
        </label>
      </div>
    </div>
    <div class="flex gap-3">
      <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700">Crear</button>
      <a href="<%= listPath %>" class="bg-gray-200 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-300">Cancelar</a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>