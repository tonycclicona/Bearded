<%- include('../partials/header') %>

<div class="max-w-3xl mx-auto">
  <h1 class="text-3xl font-bold mb-8">Editar Foto</h1>

  <form action="<%= listPath %>/<%= row.id %>/edit" method="POST" enctype="multipart/form-data" class="bg-white rounded-lg shadow p-6 space-y-4">
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Título</label>
      <input type="text" name="title" value="<%= row.title %>" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
    </div>
    <div class="grid grid-cols-3 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Slug</label>
        <input type="text" name="slug" value="<%= row.slug %>" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Precio (S/.)</label>
        <input type="number" name="price" step="0.01" value="<%= row.price %>" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Orden</label>
        <input type="number" name="sortOrder" value="<%= row.sortOrder %>" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
      </div>
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Tipo</label>
        <select name="type" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
          <option value="AVES" <%= row.type === 'AVES' ? 'selected' : '' %>>Aves</option>
          <option value="PAISAJE" <%= row.type === 'PAISAJE' ? 'selected' : '' %>>Paisaje</option>
        </select>
      </div>
      <div class="flex items-center gap-2 text-sm font-medium text-gray-700 mt-6">
        <input type="checkbox" name="featured" <%= row.featured ? 'checked' : '' %> class="w-4 h-4">
        Destacado
      </div>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">URL de Imagen (o sube un archivo)</label>
      <input type="url" name="imageUrl" value="<%= row.imageUrl %>" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
      <input type="file" name="image" accept="image/*" class="mt-2 block w-full text-sm text-gray-500">
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Descripción</label>
      <textarea name="description" rows="3" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none"><%= row.description %></textarea>
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Especie (opcional)</label>
        <input type="text" name="species" value="<%= row.species || '' %>" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Ubicación</label>
        <input type="text" name="location" value="<%= row.location || '' %>" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
      </div>
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Cámara</label>
        <input type="text" name="camera" value="<%= row.camera || '' %>" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Resolución</label>
        <input type="text" name="resolution" value="<%= row.resolution || '' %>" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
      </div>
    </div>
    <div class="flex gap-3">
      <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700">Guardar</button>
      <a href="<%= listPath %>" class="bg-gray-200 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-300">Cancelar</a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
