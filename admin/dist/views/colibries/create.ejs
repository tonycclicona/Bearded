<%- include('../partials/header') %>

<div class="max-w-4xl mx-auto space-y-6">
  <div class="bg-white dark:bg-[#131B15] p-6 rounded-3xl border border-gray-200 dark:border-[#24301f] shadow-sm">
    <div class="flex items-center gap-2 text-xs text-[#C5A880] uppercase tracking-wider font-bold mb-1">
      <span>Ornitología & Catálogo</span>
    </div>
    <h1 class="text-2xl md:text-3xl font-serif font-bold text-[#1E2C22] dark:text-white">
      Registrar Nueva Especie de Colibrí / Ave
    </h1>
    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
      Añade la taxonomía, rango altitudinal, fotos y cantos bioacústicos en MP3/WAV.
    </p>
  </div>

  <form action="<%= listPath %>/create" method="POST" enctype="multipart/form-data" class="bg-white dark:bg-[#131B15] rounded-3xl border border-gray-200 dark:border-[#24301f] shadow-sm p-6 sm:p-8 space-y-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 dark:text-gray-300 mb-1">Nombre Común</label>
        <input type="text" name="nombreComun" required placeholder="Ej: Colibrí Cola de Espátula" class="w-full px-4 py-2.5 bg-gray-50 dark:bg-[#0E1511] border border-gray-200 dark:border-[#24301f] rounded-xl text-xs focus:ring-2 focus:ring-[#C5A880] focus:outline-none">
      </div>
      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 dark:text-gray-300 mb-1">Nombre Científico</label>
        <input type="text" name="nombreCientifico" required placeholder="Ej: Loddigesia mirabilis" class="w-full px-4 py-2.5 bg-gray-50 dark:bg-[#0E1511] border border-gray-200 dark:border-[#24301f] rounded-xl text-xs focus:ring-2 focus:ring-[#C5A880] focus:outline-none italic">
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 dark:text-gray-300 mb-1">Familia</label>
        <input type="text" name="familia" value="Trochilidae" required class="w-full px-4 py-2.5 bg-gray-50 dark:bg-[#0E1511] border border-gray-200 dark:border-[#24301f] rounded-xl text-xs focus:ring-2 focus:ring-[#C5A880] focus:outline-none">
      </div>
      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 dark:text-gray-300 mb-1">Estado IUCN</label>
        <select name="estadoIUCN" required class="w-full px-4 py-2.5 bg-gray-50 dark:bg-[#0E1511] border border-gray-200 dark:border-[#24301f] rounded-xl text-xs focus:ring-2 focus:ring-[#C5A880] focus:outline-none">
          <option value="En Peligro Crítico (CR)">En Peligro Crítico (CR)</option>
          <option value="En Peligro (EN)">En Peligro (EN)</option>
          <option value="Vulnerable (VU)">Vulnerable (VU)</option>
          <option value="Casi Amenazado (NT)">Casi Amenazado (NT)</option>
          <option value="Preocupación Menor (LC)" selected>Preocupación Menor (LC)</option>
        </select>
      </div>
      <div class="flex items-center pt-5">
        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox" name="endemicoPeru" class="w-4 h-4 text-purple-600 rounded border-gray-300">
          <span class="text-xs font-bold text-gray-700 dark:text-gray-300">🇵🇪 Endémico de Perú</span>
        </label>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 dark:text-gray-300 mb-1">Altitud Mínima (msnm)</label>
        <input type="number" name="altitudMinMsnm" value="1500" class="w-full px-4 py-2.5 bg-gray-50 dark:bg-[#0E1511] border border-gray-200 dark:border-[#24301f] rounded-xl text-xs focus:ring-2 focus:ring-[#C5A880] focus:outline-none">
      </div>
      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 dark:text-gray-300 mb-1">Altitud Máxima (msnm)</label>
        <input type="number" name="altitudMaxMsnm" value="3500" class="w-full px-4 py-2.5 bg-gray-50 dark:bg-[#0E1511] border border-gray-200 dark:border-[#24301f] rounded-xl text-xs focus:ring-2 focus:ring-[#C5A880] focus:outline-none">
      </div>
    </div>

    <div>
      <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 dark:text-gray-300 mb-1">Descripción Taxonómica y Hábitat</label>
      <textarea name="descripcion" rows="3" required placeholder="Describe las características morfológicas, comportamiento y hábitat..." class="w-full px-4 py-2.5 bg-gray-50 dark:bg-[#0E1511] border border-gray-200 dark:border-[#24301f] rounded-xl text-xs focus:ring-2 focus:ring-[#C5A880] focus:outline-none"></textarea>
    </div>

    <!-- SUBIDA DE IMAGEN CON DRAG & DROP -->
    <div class="p-5 bg-gray-50/70 dark:bg-[#0E1511]/70 rounded-2xl border border-gray-200 dark:border-[#24301f] space-y-2">
      <label class="block text-xs font-bold uppercase tracking-wider text-[#1E2C22] dark:text-[#C5A880]">
        📸 Foto Principal de la Especie (Optimización WebP)
      </label>
      <input type="url" name="fotoPrincipal" placeholder="O pega una URL externa directa (https://...)" class="w-full px-4 py-2.5 bg-white dark:bg-[#131B15] border border-gray-200 dark:border-[#24301f] rounded-xl text-xs focus:ring-2 focus:ring-[#C5A880] focus:outline-none mb-2">
      <input type="file" name="image" accept="image/*,.webp,.jpg,.jpeg,.png" class="block w-full text-sm text-gray-500">
    </div>

    <!-- SUBIDA DE AUDIO CON DRAG & DROP -->
    <div class="p-5 bg-gray-50/70 dark:bg-[#0E1511]/70 rounded-2xl border border-gray-200 dark:border-[#24301f] space-y-2">
      <label class="block text-xs font-bold uppercase tracking-wider text-[#1E2C22] dark:text-[#C5A880]">
        🎵 Registro de Audio / Canto Bioacústico (MP3, WAV, OGG, M4A)
      </label>
      <input type="url" name="audioCantoUrl" placeholder="https://www.xeno-canto.org/sounds/... o pega una URL directa" class="w-full px-4 py-2.5 bg-white dark:bg-[#131B15] border border-gray-200 dark:border-[#24301f] rounded-xl text-xs focus:ring-2 focus:ring-[#C5A880] focus:outline-none mb-2">
      <input type="file" name="audioFile" accept="audio/*,.mp3,.wav,.ogg,.m4a,.aac,.flac" class="block w-full text-sm text-gray-500">
    </div>

    <div class="flex gap-3 pt-4 border-t border-gray-100 dark:border-[#24301f]">
      <button type="submit" class="bg-[#1E2C22] hover:bg-[#C5A880] text-white hover:text-[#1E2C22] px-6 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider transition-all shadow-sm">
        Guardar Especie
      </button>
      <a href="<%= listPath %>" class="bg-gray-100 dark:bg-[#1E2C22]/50 text-gray-700 dark:text-gray-300 px-6 py-2.5 rounded-xl text-xs font-semibold hover:bg-gray-200 transition-colors">
        Cancelar
      </a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
