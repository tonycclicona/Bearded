<%- include('../partials/header') %>

<div class="max-w-7xl mx-auto">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold">Rutas de Avistamiento</h1>
    <a href="<%= listPath %>/create" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 text-sm">+ Nueva Ruta</a>
  </div>

  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="w-full">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Orden</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Título</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Dificultad</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Duración</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Precio</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Acciones</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% rows.slice().sort((a, b) => a.sortOrder - b.sortOrder).forEach(row => { %>
        <tr>
          <td class="px-6 py-4 text-sm text-gray-500"><%= row.sortOrder %></td>
          <td class="px-6 py-4 text-sm font-medium text-gray-900"><%= row.title %></td>
          <td class="px-6 py-4 text-sm">
            <span class="px-2 py-1 rounded-full text-xs font-medium
              <%= row.difficulty === 'FACIL' ? 'bg-green-100 text-green-800' : row.difficulty === 'MODERADO' ? 'bg-yellow-100 text-yellow-800' : 'bg-red-100 text-red-800' %>">
              <%= row.difficulty %>
            </span>
          </td>
          <td class="px-6 py-4 text-sm text-gray-600"><%= row.duration %></td>
          <td class="px-6 py-4 text-sm text-gray-600">S/. <%= row.price %></td>
          <td class="px-6 py-4 text-right text-sm space-x-2">
            <a href="<%= listPath %>/<%= row.id %>/edit" class="text-blue-600 hover:underline">Editar</a>
            <form action="<%= listPath %>/<%= row.id %>/delete" method="POST" class="inline" onsubmit="return confirm('¿Eliminar esta ruta?')">
              <button type="submit" class="text-red-600 hover:underline">Eliminar</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>