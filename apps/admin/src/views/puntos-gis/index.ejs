<%- include('../partials/header') %>

<!-- Leaflet CDN -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<div class="max-w-7xl mx-auto space-y-6">
  
  <!-- Encabezado -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-white dark:bg-[#131B15] p-6 rounded-3xl border border-gray-200 dark:border-[#24301f] shadow-sm">
    <div>
      <div class="flex items-center gap-2 text-xs text-[#C5A880] uppercase tracking-wider font-bold mb-1">
        <span>Ornitología & GIS Perú</span>
      </div>
      <h1 class="text-2xl md:text-3xl font-serif font-bold text-[#1E2C22] dark:text-white">
        Puntos & Hotspots GIS
      </h1>
      <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
        Gestión y georreferenciación de santuarios, comederos botánicos y zonas de especies endémicas.
      </p>
    </div>
    <div class="flex items-center gap-3">
      <a
        href="<%= listPath %>/create"
        class="px-5 py-2.5 bg-[#1E2C22] hover:bg-[#C5A880] text-white hover:text-[#1E2C22] rounded-xl text-xs font-bold uppercase tracking-wider transition-all flex items-center gap-2 shadow-sm"
      >
        <span>+ Nuevo Punto GIS</span>
      </a>
    </div>
  </div>

  <!-- MAPA PANORÁMICO DE HOTSPOTS EN PERÚ -->
  <div class="bg-white dark:bg-[#131B15] rounded-3xl p-5 border border-gray-200 dark:border-[#24301f] shadow-sm space-y-3">
    <div class="flex items-center justify-between">
      <h2 class="text-xs font-bold uppercase tracking-wider text-[#1E2C22] dark:text-[#C5A880] flex items-center gap-2">
        <span>🗺️</span> Vista Espacial en Mapa de Perú (<%= rows.length %> Hotspots)
      </h2>
      <span class="text-[11px] text-gray-500 dark:text-gray-400">
        Haz clic en cualquier pin para ver detalles o editar
      </span>
    </div>
    
    <div class="relative rounded-2xl overflow-hidden border border-gray-200 dark:border-[#24301f] shadow-inner">
      <div id="overviewGisMap" style="height: 360px; width: 100%; z-index: 10;"></div>
    </div>
  </div>

  <!-- TABLA DE PUNTOS GIS -->
  <div class="bg-white dark:bg-[#131B15] rounded-3xl border border-gray-200 dark:border-[#24301f] shadow-sm overflow-hidden">
    <div class="p-5 border-b border-gray-100 dark:border-[#24301f] flex justify-between items-center">
      <h3 class="text-xs font-bold uppercase tracking-wider text-gray-600 dark:text-gray-400">
        Listado de Puntos Registrados
      </h3>
      <span class="text-xs font-semibold text-gray-500">Total: <%= rows.length %></span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left">
        <thead class="bg-gray-50 dark:bg-[#0E1511] text-gray-500 dark:text-gray-400 text-[10px] uppercase font-bold tracking-wider">
          <tr>
            <th class="px-6 py-3.5">Nombre & Slug</th>
            <th class="px-6 py-3.5">Categoría GIS</th>
            <th class="px-6 py-3.5">Departamento</th>
            <th class="px-6 py-3.5">Coordenadas</th>
            <th class="px-6 py-3.5">Altitud</th>
            <th class="px-6 py-3.5">Estado</th>
            <th class="px-6 py-3.5 text-right">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 dark:divide-[#24301f]/60 text-xs">
          <% rows.forEach(row => { %>
          <tr class="hover:bg-gray-50/80 dark:hover:bg-[#1E2C22]/20 transition-colors">
            <td class="px-6 py-4">
              <div class="font-bold text-[#1E2C22] dark:text-white"><%= row.nombre %></div>
              <div class="text-[10px] text-gray-400 font-mono"><%= row.slug %></div>
            </td>
            <td class="px-6 py-4">
              <% 
                let badgeColor = 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300';
                if (row.categoria === 'OBSERVATORIO_SILVESTRE') badgeColor = 'bg-sky-100 text-sky-800 dark:bg-sky-950 dark:text-sky-300';
                if (row.categoria === 'ESPECIE_ENDEMICA') badgeColor = 'bg-purple-100 text-purple-800 dark:bg-purple-950 dark:text-purple-300';
                if (row.categoria === 'CAMPAMENTO_REFUGIO') badgeColor = 'bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300';
                if (row.categoria === 'LOGISTICA_PUNTO_ENCUENTRO') badgeColor = 'bg-red-100 text-red-800 dark:bg-red-950 dark:text-red-300';
              %>
              <span class="inline-block text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full <%= badgeColor %>">
                <%= row.categoria.replace('_', ' ') %>
              </span>
            </td>
            <td class="px-6 py-4 font-semibold text-gray-700 dark:text-gray-300"><%= row.departamento %></td>
            <td class="px-6 py-4 font-mono text-[11px] text-gray-500 dark:text-gray-400">
              <%= Number(row.latitud).toFixed(4) %>, <%= Number(row.longitud).toFixed(4) %>
            </td>
            <td class="px-6 py-4 font-semibold text-gray-700 dark:text-gray-300"><%= row.altitudMsnm %> msnm</td>
            <td class="px-6 py-4">
              <% if (row.activo) { %>
              <span class="text-[10px] text-emerald-700 bg-emerald-100 dark:bg-emerald-950 dark:text-emerald-300 font-bold uppercase tracking-wider px-2 py-0.5 rounded-full">Activo</span>
              <% } else { %>
              <span class="text-[10px] text-gray-500 bg-gray-100 dark:bg-gray-800 dark:text-gray-400 font-bold uppercase tracking-wider px-2 py-0.5 rounded-full">Inactivo</span>
              <% } %>
            </td>
            <td class="px-6 py-4 text-right space-x-3">
              <a href="<%= listPath %>/<%= row.id %>/edit" class="text-[#C5A880] hover:text-[#1E2C22] dark:hover:text-white font-bold hover:underline">
                Editar
              </a>
              <form action="<%= listPath %>/<%= row.id %>/delete" method="POST" class="inline" onsubmit="return confirm('¿Estás seguro de eliminar el punto <%= row.nombre %>?')">
                <button type="submit" class="text-red-500 hover:text-red-700 font-semibold hover:underline">
                  Eliminar
                </button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- SCRIPT DEL MAPA PANORÁMICO CON TODOS LOS PUNTOS -->
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const rawData = <%- JSON.stringify(rows.map(r => ({
      id: r.id,
      nombre: r.nombre,
      categoria: r.categoria,
      departamento: r.departamento,
      latitud: Number(r.latitud),
      longitud: Number(r.longitud),
      altitudMsnm: r.altitudMsnm,
      listPath: listPath
    }))) %>;

    const map = L.map('overviewGisMap', {
      center: [-9.19, -75.015],
      zoom: 6,
      scrollWheelZoom: true
    });

    L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
      attribution: '&copy; OpenStreetMap contributors &copy; CARTO'
    }).addTo(map);

    const CATEGORY_COLORS = {
      HOTSPOT_COMEDERO: { bg: '#10b981', icon: '🍃' },
      OBSERVATORIO_SILVESTRE: { bg: '#0284c7', icon: '🔭' },
      ESPECIE_ENDEMICA: { bg: '#8b5cf6', icon: '👑' },
      CAMPAMENTO_REFUGIO: { bg: '#f59e0b', icon: '⛺' },
      LOGISTICA_PUNTO_ENCUENTRO: { bg: '#f43f5e', icon: '📍' }
    };

    const markers = [];

    rawData.forEach(p => {
      const catStyle = CATEGORY_COLORS[p.categoria] || CATEGORY_COLORS.HOTSPOT_COMEDERO;
      const icon = L.divIcon({
        className: 'overview-gis-pin',
        html: `
          <div style="
            width: 32px; height: 32px;
            background: ${catStyle.bg};
            border: 2.5px solid #ffffff;
            border-radius: 50% 50% 50% 0;
            transform: rotate(-45deg);
            box-shadow: 0 3px 10px rgba(0,0,0,0.3);
            display: flex; align-items: center; justify-content: center;
          ">
            <span style="transform: rotate(45deg); font-size: 12px;">${catStyle.icon}</span>
          </div>
        `,
        iconSize: [32, 32],
        iconAnchor: [16, 32]
      });

      const marker = L.marker([p.latitud, p.longitud], { icon }).addTo(map);
      marker.bindPopup(`
        <div class="p-1 text-xs">
          <span class="text-[9px] font-bold uppercase tracking-wider text-emerald-700 block">${p.categoria.replace('_', ' ')}</span>
          <strong class="font-serif font-bold text-sm text-[#1E2C22] block mt-0.5">${p.nombre}</strong>
          <p class="text-gray-600 text-[11px]">${p.departamento} • <strong>${p.altitudMsnm} msnm</strong></p>
          <a href="${p.listPath}/${p.id}/edit" class="mt-2 inline-block bg-[#1E2C22] text-[#C5A880] hover:bg-[#C5A880] hover:text-[#1E2C22] text-[10px] font-bold px-3 py-1 rounded-lg transition-colors">
            Editar Punto GIS →
          </a>
        </div>
      `);
      markers.push(marker);
    });

    if (markers.length > 0) {
      const group = new L.featureGroup(markers);
      map.fitBounds(group.getBounds().pad(0.15));
    }
  });
</script>

<%- include('../partials/footer') %>
