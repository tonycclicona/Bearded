<%- include('../partials/header') %>

<div class="max-w-3xl mx-auto">
  <h1 class="text-3xl font-bold mb-8">Editar Escenario</h1>

  <form action="<%= listPath %>/<%= row.id %>/edit" method="POST" enctype="multipart/form-data" class="bg-white rounded-lg shadow p-6 space-y-4">
    <% if (row.imageUrl) { %>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Fotografía actual</label>
      <img src="<%= row.imageUrl %>" alt="<%= row.title %>" class="h-40 w-full object-cover rounded-lg border border-gray-200">
    </div>
    <% } %>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Nombre</label>
      <input type="text" name="title" value="<%= row.title %>" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Descripción</label>
      <textarea name="description" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none"><%= row.description %></textarea>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Beneficios (uno por línea)</label>
      <textarea name="benefits" rows="5" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none"><%= row.benefits.join('\n') %></textarea>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Reemplazar fotografía</label>
      <input type="url" name="imageUrl" placeholder="URL de imagen (opcional)" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
      <input type="file" name="image" accept="image/*" class="mt-2 block w-full text-sm text-gray-500">
      <p class="mt-1 text-xs text-gray-400">La imagen se optimizará automáticamente a formato WebP (más ligera y rápida).</p>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Orden</label>
      <input type="number" name="sortOrder" value="<%= row.sortOrder %>" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
    </div>
    <div class="flex gap-3">
      <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700">Guardar</button>
      <a href="<%= listPath %>" class="bg-gray-200 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-300">Cancelar</a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>