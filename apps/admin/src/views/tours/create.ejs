<%- include('../partials/header') %>

<div class="max-w-3xl mx-auto">
  <h1 class="text-3xl font-bold mb-8">Crear Tour / Expedición</h1>

  <form action="<%= listPath %>/create" method="POST" class="bg-white rounded-lg shadow p-6 space-y-4">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Nombre de la Expedición</label>
        <input type="text" name="nombre" required placeholder="Ej: Expedición Colibrí Cola de Espátula" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Slug</label>
        <input type="text" name="slug" placeholder="Opcional: auto-generado" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Región de Ruta</label>
        <select name="regionRuta" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
          <option value="Ruta Norte">Ruta Norte (Amazonas / San Martín)</option>
          <option value="Ruta Centro">Ruta Centro (Huánuco / Pasco / Lima)</option>
          <option value="Ruta Sur Manu">Ruta Sur Manu (Cusco / Manu / Arequipa)</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Nivel de Caminata</label>
        <select name="nivelCaminata" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
          <option value="Fácil / Fotografía">Fácil / Fotografía</option>
          <option value="Moderado">Moderado</option>
          <option value="Exigente / Alta Montaña">Exigente / Alta Montaña</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Duración (Días)</label>
        <input type="number" name="duracion_dias" value="5" min="1" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 bg-gray-50 p-4 rounded-xl border border-gray-200">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Precio por Adulto en Soles (PEN S/.)</label>
        <input type="number" step="0.01" name="precio_adulto" required placeholder="1850.00" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
        <label class="flex items-center gap-2 mt-2 text-xs font-semibold text-gray-700">
          <input type="checkbox" name="showPEN" checked class="w-4 h-4 text-blue-600 rounded">
          <span>Habilitar / Mostrar monto en Soles (PEN)</span>
        </label>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Precio por Adulto en Dólares (USD $)</label>
        <input type="number" step="0.01" name="precio_adulto_usd" placeholder="500.00" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
        <label class="flex items-center gap-2 mt-2 text-xs font-semibold text-gray-700">
          <input type="checkbox" name="showUSD" class="w-4 h-4 text-blue-600 rounded">
          <span>Habilitar / Mostrar monto en Dólares (USD)</span>
        </label>
      </div>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Cupos Disponibles</label>
      <input type="number" name="cupos_disponibles" value="8" min="1" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Equipo Óptico Requerido / Recomendado</label>
      <input type="text" name="equipoOpticoReq" placeholder="Ej: Telescopio terrestre 80mm, Binoculares 8x42" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Descripción</label>
      <textarea name="descripcion" rows="3" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none"></textarea>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Itinerario Detallado (Día a Día)</label>
      <textarea name="itinerario" rows="3" placeholder="Día 1: ... Día 2: ..." class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none"></textarea>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Servicios Incluidos (JSON o texto)</label>
        <textarea name="servicios_incluidos" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none"></textarea>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Servicios Excluidos</label>
        <textarea name="servicios_excluidos" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none"></textarea>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Qué Llevar</label>
        <textarea name="que_llevar" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none"></textarea>
      </div>
    </div>

    <div class="flex gap-6">
      <label class="flex items-center gap-2 cursor-pointer">
        <input type="checkbox" name="activo" checked class="w-4 h-4 text-blue-600 rounded">
        <span class="text-sm font-medium text-gray-700">Tour Activo</span>
      </label>
      <label class="flex items-center gap-2 cursor-pointer">
        <input type="checkbox" name="destacado" class="w-4 h-4 text-amber-600 rounded">
        <span class="text-sm font-medium text-gray-700">⭐ Destacar en Portada</span>
      </label>
    </div>

    <div class="flex gap-3 pt-4">
      <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 font-semibold">Guardar Tour</button>
      <a href="<%= listPath %>" class="bg-gray-200 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-300">Cancelar</a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
