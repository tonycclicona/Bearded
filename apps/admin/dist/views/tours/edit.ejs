<%- include('../partials/header') %>

<div class="max-w-3xl mx-auto">
  <h1 class="text-3xl font-bold mb-8">Editar Tour / Expedición</h1>

  <form action="<%= listPath %>/<%= row.id %>/edit" method="POST" class="bg-white rounded-lg shadow p-6 space-y-4">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Nombre de la Expedición</label>
        <input type="text" name="nombre" value="<%= row.nombre %>" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Slug</label>
        <input type="text" name="slug" value="<%= row.slug %>" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Región de Ruta</label>
        <select name="regionRuta" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
          <option value="Ruta Norte" <%= row.regionRuta === 'Ruta Norte' ? 'selected' : '' %>>Ruta Norte (Amazonas / San Martín)</option>
          <option value="Ruta Centro" <%= row.regionRuta === 'Ruta Centro' ? 'selected' : '' %>>Ruta Centro (Huánuco / Pasco / Lima)</option>
          <option value="Ruta Sur Manu" <%= row.regionRuta === 'Ruta Sur Manu' ? 'selected' : '' %>>Ruta Sur Manu (Cusco / Manu / Arequipa)</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Nivel de Caminata</label>
        <select name="nivelCaminata" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
          <option value="Fácil / Fotografía" <%= row.nivelCaminata === 'Fácil / Fotografía' ? 'selected' : '' %>>Fácil / Fotografía</option>
          <option value="Moderado" <%= row.nivelCaminata === 'Moderado' ? 'selected' : '' %>>Moderado</option>
          <option value="Exigente / Alta Montaña" <%= row.nivelCaminata === 'Exigente / Alta Montaña' ? 'selected' : '' %>>Exigente / Alta Montaña</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Duración (Días)</label>
        <input type="number" name="duracion_dias" value="<%= row.duracion_dias %>" min="1" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 bg-gray-50 p-4 rounded-xl border border-gray-200">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Precio por Adulto en Soles (PEN S/.)</label>
        <input type="number" step="0.01" name="precio_adulto" value="<%= Number(row.precio_adulto) %>" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
        <label class="flex items-center gap-2 mt-2 text-xs font-semibold text-gray-700">
          <input type="checkbox" name="showPEN" <%= row.showPEN ? 'checked' : '' %> class="w-4 h-4 text-blue-600 rounded">
          <span>Habilitar / Mostrar monto en Soles (PEN)</span>
        </label>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Precio por Adulto en Dólares (USD $)</label>
        <input type="number" step="0.01" name="precio_adulto_usd" value="<%= row.precio_adulto_usd ? Number(row.precio_adulto_usd) : '' %>" placeholder="500.00" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
        <label class="flex items-center gap-2 mt-2 text-xs font-semibold text-gray-700">
          <input type="checkbox" name="showUSD" <%= row.showUSD ? 'checked' : '' %> class="w-4 h-4 text-blue-600 rounded">
          <span>Habilitar / Mostrar monto en Dólares (USD)</span>
        </label>
      </div>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Cupos Disponibles</label>
      <input type="number" name="cupos_disponibles" value="<%= row.cupos_disponibles %>" min="1" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Equipo Óptico Requerido</label>
      <input type="text" name="equipoOpticoReq" value="<%= row.equipoOpticoReq || '' %>" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Descripción</label>
      <textarea name="descripcion" rows="3" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none"><%= row.descripcion %></textarea>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Itinerario Detallado</label>
      <textarea name="itinerario" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none"><%= row.itinerario || '' %></textarea>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Servicios Incluidos</label>
        <textarea name="servicios_incluidos" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none"><%= row.servicios_incluidos %></textarea>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Servicios Excluidos</label>
        <textarea name="servicios_excluidos" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none"><%= row.servicios_excluidos %></textarea>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Qué Llevar</label>
        <textarea name="que_llevar" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none"><%= row.que_llevar %></textarea>
      </div>
    </div>

    <div class="flex gap-6">
      <label class="flex items-center gap-2 cursor-pointer">
        <input type="checkbox" name="activo" <%= row.activo ? 'checked' : '' %> class="w-4 h-4 text-blue-600 rounded">
        <span class="text-sm font-medium text-gray-700">Tour Activo</span>
      </label>
      <label class="flex items-center gap-2 cursor-pointer">
        <input type="checkbox" name="destacado" <%= row.destacado ? 'checked' : '' %> class="w-4 h-4 text-amber-600 rounded">
        <span class="text-sm font-medium text-gray-700">⭐ Destacar en Portada</span>
      </label>
    </div>

    <div class="flex gap-3 pt-4">
      <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 font-semibold">Guardar Cambios</button>
      <a href="<%= listPath %>" class="bg-gray-200 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-300">Cancelar</a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
