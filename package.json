{
  "name": "antigravity",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "admin",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:admin\" \"npm run dev:frontend\"",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev:admin\" \"npm run dev:frontend\" \"node server.js\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:admin": "npm run dev --workspace=admin",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "node postinstall.cjs",
    "build:backend": "npm run build --workspace=backend",
    "build:admin": "npm run build --workspace=admin",
    "build:frontend": "npm run build --workspace=frontend",
    "build:compile": "npm run build:backend && npm run build:admin && npm run build:frontend && node postinstall.cjs",
    "start": "node server.js",
    "typecheck": "npm run typecheck --workspaces",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:push": "npm run db:push --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend",
    "db:studio": "npm run db:studio --workspace=backend",
    "prisma:generate": "prisma generate --schema=backend/prisma/schema.prisma",
    "postinstall": "node postinstall.cjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.2",
    "@types/node": "^22.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "http-proxy-middleware": "^3.0.3",
    "multer": "^2.2.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5.7.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.2",
    "@types/node": "^22.0.0",
    "concurrently": "^9.1.2",
    "prisma": "^6.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
