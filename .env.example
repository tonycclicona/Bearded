# ==============================================================================
# .env.example — Bearded Mountaineer Lodge
# INSTRUCCIONES:
#   1. Copia este archivo a .env en la raíz del proyecto
#   2. Rellena TODOS los valores marcados con [REEMPLAZAR]
#   3. NUNCA subas .env al repositorio (está en .gitignore)
#   4. En Hostinger: configura estas variables en el panel de la
#      aplicación Node.js (Environment Variables)
#
# Ver deployment/.env.example para la versión completa y documentada.
# ==============================================================================

# ENTORNO
NODE_ENV="production"

# PUERTOS
PORT=4000
GATEWAY_PORT=4000
ADMIN_PORT=3002

# BASE DE DATOS (MySQL Hostinger)
# Formato: mysql://usuario:password@localhost:3306/nombre_db
DATABASE_URL="mysql://[USUARIO_DB]:[PASSWORD_DB]@localhost:3306/[NOMBRE_DB]"

# SEGURIDAD
# Genera con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="[CLAVE_JWT_ALEATORIA_MIN_32_CHARS]"
JWT_EXPIRES_IN="7d"
SESSION_SECRET="[CLAVE_SESSION_ALEATORIA_MIN_32_CHARS]"

# CORS (orígenes permitidos, separados por comas)
CORS_ORIGIN="https://beardedmountaineerlodge.com,https://www.beardedmountaineerlodge.com,https://admin.beardedmountaineerlodge.com,https://api.beardedmountaineerlodge.com"

# ACCESO ADMIN
ADMIN_USER="admin"
ADMIN_EMAIL="[EMAIL_ADMIN]"
ADMIN_PASSWORD="[PASSWORD_ADMIN_SEGURO]"

# URLs PÚBLICAS (compiladas en el frontend en tiempo de build)
# IMPORTANTE: Cambiar estas variables requiere recompilar el frontend.
# El frontend llama a la API via subdominio: api.beardedmountaineerlodge.com
NEXT_PUBLIC_API_URL="https://api.beardedmountaineerlodge.com/api"
NEXT_PUBLIC_ADMIN_URL="https://admin.beardedmountaineerlodge.com"

# UPLOADS
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES="image/jpeg,image/png,image/webp,image/gif"