# ==============================================================================
# .env.example — Bearded Mountaineer Lodge
# Arquitectura Hostinger Web Business (3 Dominios Independientes):
#   1. api.beardedmountaineerlodge.com   -> Web App Node.js (Express 5 + Prisma)
#   2. beardedmountaineerlodge.com       -> PHP/HTML (Next.js 16 SSG Static Export)
#   3. admin.beardedmountaineerlodge.com -> PHP/HTML (Next.js 16 SSG Static Export)
# ==============================================================================

# ==============================================================================
# SECCIÓN 1: VARIABLES PARA LA APLICACIÓN NODE.JS (Hostinger Panel -> Node.js App)
# Configurar en el panel de control de api.beardedmountaineerlodge.com
# ==============================================================================

NODE_ENV="production"
PORT=4000

# Base de datos MySQL en Hostinger
# Formato: mysql://usuario:password@localhost:3306/nombre_db
DATABASE_URL="mysql://[USUARIO_DB]:[PASSWORD_DB]@localhost:3306/[NOMBRE_DB]"

# Carpeta única de medios (Uploads)
# Ruta absoluta en Hostinger o relativa al backend. Ej:
# /home/u251936581/domains/api.beardedmountaineerlodge.com/public_html/uploads
UPLOADS_DIR="./uploads"

# Seguridad y Autenticación JWT
# Generar claves con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="[CLAVE_JWT_ALEATORIA_MIN_32_CHARS]"
JWT_EXPIRES_IN="7d"
SESSION_SECRET="[CLAVE_SESSION_ALEATORIA_MIN_32_CHARS]"

# CORS — Dominios autorizados para interactuar con la API
CORS_ORIGIN="https://beardedmountaineerlodge.com,https://www.beardedmountaineerlodge.com,https://admin.beardedmountaineerlodge.com,https://api.beardedmountaineerlodge.com"

# Credenciales de Administrador Inicial
ADMIN_USER="admin"
ADMIN_EMAIL="[EMAIL_ADMIN]"
ADMIN_PASSWORD="[PASSWORD_ADMIN_SEGURO]"

# Límites de Subida
UPLOAD_MAX_SIZE=31457280
UPLOAD_ALLOWED_TYPES="image/jpeg,image/png,image/webp,image/gif,image/svg+xml,audio/mpeg,audio/wav,application/pdf,video/mp4"

# ==============================================================================
# SECCIÓN 2: VARIABLES DE COMPILACIÓN FRONTEND Y ADMIN (Build time / SSG)
# Se incrustan en el HTML/JS estático durante: npm run build:frontend / npm run build:admin
# ==============================================================================

NEXT_PUBLIC_API_URL="https://api.beardedmountaineerlodge.com/api"
NEXT_PUBLIC_ADMIN_URL="https://admin.beardedmountaineerlodge.com"