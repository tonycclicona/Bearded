# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO (PLANTILLA)
# Bearded Mountaineer Lodge — Monorepo
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS (MySQL Nativo Hostinger / phpMyAdmin o Local)
# ------------------------------------------------------------------------------
# Formato: mysql://usuario:password@host:3306/nombre_db
DATABASE_URL="mysql://usuario:password@localhost:3306/bearded_lodge"

# ------------------------------------------------------------------------------
# 2. PUERTOS Y ENTORNO
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=3001
ADMIN_PORT=3002
GATEWAY_PORT=4000

# ------------------------------------------------------------------------------
# 3. SEGURIDAD & SESIONES
# ------------------------------------------------------------------------------
JWT_SECRET="genera-una-clave-secreta-larga-y-aleatoria"
JWT_EXPIRES_IN="7d"
SESSION_SECRET="genera-otra-clave-secreta-para-sesiones-admin"
CORS_ORIGIN="https://tudominio.com,https://admin.tudominio.com,https://api.tudominio.com"

# ------------------------------------------------------------------------------
# 4. ACCESO AL PANEL DE ADMINISTRACIÓN
# ------------------------------------------------------------------------------
ADMIN_USER="admin"
ADMIN_EMAIL="admin@tudominio.com"
ADMIN_PASSWORD="TuPasswordSeguro123!"

# ------------------------------------------------------------------------------
# 5. URLS PÚBLICAS DEL FRONTEND (NEXT.JS)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="https://api.tudominio.com/api"
NEXT_PUBLIC_ADMIN_URL="https://admin.tudominio.com"