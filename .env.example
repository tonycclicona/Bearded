# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO — BEARDED MOUNTAINEER LODGE
# ==============================================================================
# Este archivo contiene todas las variables requeridas para desplegar en Hostinger
# usando una ÚNICA Web App de Node.js que orquesta el Frontend, Backend y Admin.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS (PostgreSQL en Hostinger VPS o Cloud: Supabase / Neon / Render)
# ------------------------------------------------------------------------------
# Formato: postgresql://[USUARIO]:[CONTRASEÑA]@[HOST]:[PUERTO]/[NOMBRE_BD]?schema=public
# Ejemplo en Hostinger VPS local:
DATABASE_URL="postgresql://bearded_user:TuPasswordSeguro123@localhost:5432/bearded_db?schema=public"

# ------------------------------------------------------------------------------
# 2. ENTORNO DE EJECUCIÓN & GATEWAY UNIFICADO (server.js)
# ------------------------------------------------------------------------------
NODE_ENV="production"

# Puerto expuesto al servidor web / Nginx de Hostinger (por defecto 8080 o el puerto asignado por Hostinger)
GATEWAY_PORT=8080

# Puertos internos de los microservicios (usados por el Reverse Proxy en server.js / PM2)
PORT=3001
ADMIN_PORT=3002
FRONTEND_TARGET="http://localhost:3000"
BACKEND_TARGET="http://localhost:3001"
ADMIN_TARGET="http://localhost:3002"

# ------------------------------------------------------------------------------
# 3. SEGURIDAD & AUTENTICACIÓN
# ------------------------------------------------------------------------------
# Clave para firmar tokens JWT (Genera una cadena larga y aleatoria)
JWT_SECRET="bearded-mountaineer-lodge-jwt-secret-peru-2026-super-secure"
JWT_EXPIRES_IN="7d"

# Clave secreta para sesiones del Panel de Administración
SESSION_SECRET="bearded-mountaineer-session-secret-cusco-2026"

# Orígenes permitidos para CORS (Separados por coma si son varios)
CORS_ORIGIN="https://beardedmountaineerlodge.com,https://www.beardedmountaineerlodge.com,https://admin.beardedmountaineerlodge.com,https://api.beardedmountaineerlodge.com"

# ------------------------------------------------------------------------------
# 4. CREDENCIALES DEL PANEL DE ADMINISTRACIÓN
# ------------------------------------------------------------------------------
# Usuario inicial para acceder a https://admin.beardedmountaineerlodge.com
ADMIN_EMAIL="admin@beardedmountaineerlodge.com"
ADMIN_PASSWORD="TuPasswordAdmin2026!"

# ------------------------------------------------------------------------------
# 5. VARIABLES PÚBLICAS DEL FRONTEND (NEXT.JS)
# ------------------------------------------------------------------------------
# URL pública de la API REST para el cliente
NEXT_PUBLIC_API_URL="https://api.beardedmountaineerlodge.com/api"

# URL pública del Panel de Administración (utilizado para resolver imágenes subidas /admin/uploads/)
NEXT_PUBLIC_ADMIN_URL="https://admin.beardedmountaineerlodge.com"