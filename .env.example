# ========================================================
# ARCHIVO DE CONFIGURACIÓN DE VARIABLES DE ENTORNO (.env.example)
# ========================================================

# 1. Base de Datos (PostgreSQL o MySQL en Producción)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/antigravity?schema=public"

# 2. Gateway Monorrepo (Producción: puerto único expuesto)
GATEWAY_PORT=8080
FRONTEND_TARGET=http://localhost:3000
BACKEND_TARGET=http://localhost:3001
ADMIN_TARGET=http://localhost:3002

# 3. Backend API (Express REST)
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# 4. Autenticación & Seguridad (JWT / Sesiones)
JWT_SECRET="antigravity-colibri-jwt-secret-peru-2026"
JWT_EXPIRES_IN="7d"
SESSION_SECRET="admin-session-secret-bearded-mountaineer"

# 5. Panel de Administración (Express + EJS)
ADMIN_PORT=3002
ADMIN_EMAIL=admin@beardedmountaineer.com
ADMIN_PASSWORD=admin123

# 6. Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002