<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Rutas de subdominios o API/Admin -> Reenviar a la aplicación Node.js
  RewriteCond %{HTTP_HOST} ^api\. [NC,OR]
  RewriteCond %{HTTP_HOST} ^admin\. [NC,OR]
  RewriteCond %{REQUEST_URI} ^/api [NC,OR]
  RewriteCond %{REQUEST_URI} ^/admin [NC]
  RewriteRule ^(.*)$ http://127.0.0.1:8080/$1 [P,L]

  # 2. Servir archivos estáticos si existen físicamente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Reenviar todo lo demás al motor Node.js unificado
  RewriteRule ^(.*)$ http://127.0.0.1:8080/$1 [P,L]
</IfModule>
