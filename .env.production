# ========================================================
# ENTORNO DE PRODUCCIÓN (Hostinger VPS / Cloud)
# Dominios:
# - Frontend: https://beardedmountaineer.com
# - Admin:    https://admin.beardedmountaineer.com
# - Backend:  https://api.beardedmountaineer.com
# ========================================================

# 1. Base de Datos (PostgreSQL en Hostinger)
DATABASE_URL="postgresql://u123456789_antigravity:TuPasswordSeguro123!@localhost:5432/u123456789_antigravity?schema=public"

# 2. Gateway Monorrepo (Puerto público unificado)
PORT=8080
GATEWAY_PORT=8080
FRONTEND_TARGET=http://localhost:3000
BACKEND_TARGET=http://localhost:3001
ADMIN_TARGET=http://localhost:3002

# 3. Microservicios Internos
ADMIN_PORT=3002
NODE_ENV=production
CORS_ORIGIN="https://beardedmountaineer.com,https://www.beardedmountaineer.com,https://admin.beardedmountaineer.com,https://api.beardedmountaineer.com"

# 4. Seguridad y Secretos
JWT_SECRET="GENERA_UNA_CLAVE_SECRETA_ALEATORIA_DE_64_CARACTERES"
JWT_EXPIRES_IN="7d"
SESSION_SECRET="GENERA_UNA_CLAVE_DE_SESION_ALEATORIA_DE_64_CARACTERES"

# 5. Credenciales Iniciales del Administrador
ADMIN_EMAIL=admin@beardedmountaineer.com
ADMIN_PASSWORD=TuPasswordAdminSeguro2026!

# 6. URLs Públicas de los Servicios
NEXT_PUBLIC_API_URL=https://api.beardedmountaineer.com/api
NEXT_PUBLIC_ADMIN_URL=https://admin.beardedmountaineer.com
