# Dependencies
node_modules/
.pnpm-store/

# Build outputs (permitir dist, out y public_html para despliegue en Hostinger)
build/
.next/

# Environment files
.env
.env.*
!.env.example

# IDEs and editors
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs & Runtime
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.node_port

# Testing
coverage/

# TypeScript
*.tsbuildinfo

# Prisma (migrations MUST be committed for deploys)
apps/backend/prisma/*.js
apps/backend/prisma/*.d.ts
apps/backend/prisma/*.js.map

# Uploaded media (runtime content)
apps/admin/uploads/*
!apps/admin/uploads/.gitkeep

# Misc
*.zip
*.tar.gz
*.tar.bz2
*.tar.xz