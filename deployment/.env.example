# ==============================================================================
# .env.example — Bearded Mountaineer Lodge
# INSTRUCCIONES:
#   1. Copia este archivo a .env en la raíz del proyecto
#   2. Rellena TODOS los valores marcados con [REEMPLAZAR]
#   3. NUNCA subas .env al repositorio
#   4. En Hostinger: configura estas variables en el panel de la
#      aplicación Node.js (Environment Variables)
# ==============================================================================

# ------------------------------------------------------------------------------
# ENTORNO
# ------------------------------------------------------------------------------
NODE_ENV="production"

# ------------------------------------------------------------------------------
# PUERTOS (Node.js gateway en Hostinger)
# El puerto 4000 es el que lee proxy-api.php via .node_port
# Hostinger puede asignar PORT automáticamente; GATEWAY_PORT es el fallback
# ------------------------------------------------------------------------------
PORT=4000
GATEWAY_PORT=4000
ADMIN_PORT=3002

# ------------------------------------------------------------------------------
# BASE DE DATOS (MySQL de Hostinger)
# Obtén los datos en: Panel Hostinger → Bases de datos → MySQL
# Formato: mysql://[usuario]:[password]@localhost:3306/[nombre_db]
# ------------------------------------------------------------------------------
DATABASE_URL="mysql://[USUARIO_DB]:[PASSWORD_DB]@localhost:3306/[NOMBRE_DB]"

# ------------------------------------------------------------------------------
# SEGURIDAD — Claves JWT y Sesión
# Genera claves aleatorias seguras (mínimo 32 caracteres):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ------------------------------------------------------------------------------
JWT_SECRET="[CLAVE_JWT_ALEATORIA_MIN_32_CHARS]"
JWT_EXPIRES_IN="7d"
SESSION_SECRET="[CLAVE_SESSION_ALEATORIA_MIN_32_CHARS]"

# ------------------------------------------------------------------------------
# CORS — Orígenes permitidos
# Lista separada por comas. NO uses * en producción.
# Incluye el dominio principal y subdominios necesarios.
# ------------------------------------------------------------------------------
CORS_ORIGIN="https://beardedmountaineerlodge.com,https://www.beardedmountaineerlodge.com,https://admin.beardedmountaineerlodge.com,https://api.beardedmountaineerlodge.com"

# ------------------------------------------------------------------------------
# ACCESO AL PANEL DE ADMINISTRACIÓN
# Estas credenciales se usan para el login del admin
# ------------------------------------------------------------------------------
ADMIN_USER="admin"
ADMIN_EMAIL="[EMAIL_ADMIN]"
ADMIN_PASSWORD="[PASSWORD_ADMIN_SEGURO_MIN_12_CHARS]"

# ------------------------------------------------------------------------------
# URLs PÚBLICAS — Compiladas en el frontend Next.js en tiempo de build
# IMPORTANTE: Estas variables se graban en el HTML/JS estático.
# Si cambias la URL de la API, debes recompilar el frontend.
#
# Opciones válidas:
#   Opción A (ruta interna): NEXT_PUBLIC_API_URL=https://beardedmountaineerlodge.com/api
#   Opción B (subdominio):   NEXT_PUBLIC_API_URL=https://api.beardedmountaineerlodge.com/api
#
# Elige UNA opción y mantenla consistente con la configuración del servidor.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="https://api.beardedmountaineerlodge.com/api"
NEXT_PUBLIC_ADMIN_URL="https://admin.beardedmountaineerlodge.com"

# ------------------------------------------------------------------------------
# UPLOADS — Configuración de subida de archivos
# UPLOAD_MAX_SIZE en bytes: 10485760 = 10MB
# ------------------------------------------------------------------------------
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES="image/jpeg,image/png,image/webp,image/gif"

# ------------------------------------------------------------------------------
# CÓMO CARGAR ESTAS VARIABLES EN HOSTINGER
# ------------------------------------------------------------------------------
# Método 1 (recomendado): Panel Hostinger → Aplicaciones Node.js
#   → tu app → Environment Variables → agregar cada variable
#
# Método 2: Crear archivo .env en el directorio raíz del proyecto
#   (fuera de public_html) con el contenido real.
#   El server.js carga automáticamente .env al iniciar.
#
# NUNCA coloques el archivo .env dentro de public_html/
# ==============================================================================
