{
  "project": "bearded-mountaineer-lodge",
  "domain": "beardedmountaineerlodge.com",
  "version": "1.0.0",
  "node_version": ">=22.0.0",
  "package_manager": "npm",
  "monorepo_system": "npm-workspaces",
  "generated_at": "[GENERADO_EN_BUILD]",
  "workspaces": {
    "frontend": {
      "name": "@antigravity/frontend",
      "framework": "next.js-16-ssg",
      "output": "frontend/out/",
      "destination": "public_html/",
      "public": true,
      "execution": "static-files-apache"
    },
    "admin": {
      "name": "@antigravity/admin",
      "framework": "express-5-ejs",
      "output": "admin/dist/",
      "destination": "private/node-app",
      "public": false,
      "execution": "node server.js (gateway port 4000)"
    },
    "backend": {
      "name": "@antigravity/backend",
      "framework": "express-5-prisma",
      "output": "backend/dist/",
      "destination": "private/node-app",
      "public": false,
      "execution": "node server.js (gateway port 4000)"
    }
  },
  "gateway": {
    "entry": "server.js",
    "port": 4000,
    "routes": {
      "api.beardedmountaineerlodge.com/*": "backend/dist/index.js (via subdominio)",
      "admin.beardedmountaineerlodge.com/*": "admin/dist/index.js (via subdominio)",
      "/api/*": "backend/dist/index.js",
      "/admin/*": "admin/dist/index.js",
      "/*": "frontend/out/ (static files)"
    }
  },
  "database": {
    "type": "mysql",
    "orm": "prisma-6",
    "schema": "backend/prisma/schema.prisma",
    "migrations": "backend/prisma/migrations/"
  },
  "uploads": {
    "directory": "admin/uploads/",
    "persistent": true,
    "public_url": "/uploads/",
    "note": "NUNCA eliminar en deploy. Es un directorio persistente."
  },
  "public_html_structure": {
    "index.html": "frontend/out/index.html",
    "_next/": "frontend/out/_next/",
    ".htaccess": "deployment/deploy.sh (generado)",
    "api/index.php": "deployment/proxy-api.php (copiado)",
    "admin/index.php": "deployment/proxy-api.php (copiado)"
  },
  "build_commands": {
    "install": "npm ci",
    "prisma_generate": "npx prisma generate --schema=backend/prisma/schema.prisma",
    "build_backend": "npm run build --workspace=backend",
    "build_admin": "npm run build --workspace=admin",
    "build_frontend": "NEXT_PUBLIC_API_URL=https://api.beardedmountaineerlodge.com/api npm run build --workspace=frontend",
    "build_all": "bash deployment/build.sh",
    "deploy": "bash deployment/deploy.sh"
  },
  "hostinger_checklist": [
    "Aplicación Node.js configurada con server.js como entry point",
    "NODE_ENV=production",
    "DATABASE_URL apunta a MySQL de Hostinger",
    "JWT_SECRET y SESSION_SECRET configurados",
    "CORS_ORIGIN incluye el dominio de producción",
    "npx prisma migrate deploy ejecutado",
    "admin/uploads/ existe y tiene permisos 755"
  ]
}
