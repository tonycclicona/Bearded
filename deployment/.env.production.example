# ==============================================================================
# .env.production — Bearded Mountaineer Lodge
# ARCHIVO PARA EL SERVIDOR HOSTINGER ÚNICAMENTE
#
# INSTRUCCIONES:
#   1. Copia este archivo al servidor como ".env.production" en la raíz del proyecto
#   2. Rellena los valores reales (marcados con [REEMPLAZAR])
#   3. NUNCA lo subas al repositorio (está cubierto por .env.* en .gitignore)
#
# Next.js carga .env.production automáticamente cuando NODE_ENV=production,
# con PRIORIDAD sobre .env — las variables de desarrollo local quedan anuladas.
#
# El server.js también carga .env.production antes que .env (línea 44).
# ==============================================================================

# ENTORNO
NODE_ENV=production

# PUERTOS — Hostinger puede asignar PORT automáticamente
GATEWAY_PORT=4000

# BASE DE DATOS (MySQL Hostinger)
# Obtén los datos en: Panel Hostinger → Bases de Datos → MySQL
DATABASE_URL="mysql://[USUARIO_DB]:[PASSWORD_DB]@localhost:3306/[NOMBRE_DB]"

# SEGURIDAD — Genera claves nuevas para producción:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="[CLAVE_JWT_PRODUCCION_MIN_32_CHARS]"
JWT_EXPIRES_IN="7d"
SESSION_SECRET="[CLAVE_SESSION_PRODUCCION_MIN_32_CHARS]"

# CORS — Solo dominios reales de producción
CORS_ORIGIN="https://beardedmountaineerlodge.com,https://www.beardedmountaineerlodge.com,https://admin.beardedmountaineerlodge.com,https://api.beardedmountaineerlodge.com"

# ACCESO ADMIN — Cambia estas credenciales en producción
ADMIN_USER="admin"
ADMIN_EMAIL="[EMAIL_ADMIN_REAL]"
ADMIN_PASSWORD="[PASSWORD_ADMIN_SEGURO_MIN_12_CHARS]"

# ─────────────────────────────────────────────────────────────────────────────
# VARIABLES DEL FRONTEND — CRÍTICAS: SE COMPILAN EN EL BUNDLE ESTÁTICO
# Si cambias estos valores, debes recompilar el frontend (npm run build:frontend)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="https://api.beardedmountaineerlodge.com/api"
NEXT_PUBLIC_ADMIN_URL="https://admin.beardedmountaineerlodge.com"

# UPLOADS
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES="image/jpeg,image/png,image/webp,image/gif"
